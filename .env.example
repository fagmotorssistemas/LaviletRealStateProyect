# =============================================================================
# Separación de entornos
# =============================================================================
# Habitual (localhost → Supabase Lavilet REAL xhjnyntywqhczdtecgim):
#   npm run env:remote   # restaura .env.local desde .env
#   npm run dev
#
# Financing local opcional (127.0.0.1:54331):
#   npm run env:local-financing
#   npm run dev
#   (volver: npm run env:remote)
#
# Vercel producción: proyecto "lavilet" (www.lavilett.com). No usar proyecto "frontend".
# =============================================================================

# Público (browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_COOKIE_BANNER_ENABLED=true
# Temporal: saltar pedido de celular al abrir Simular/Financiamiento (localhost ya lo salta)
# NEXT_PUBLIC_TOUR_TOOLS_SKIP_PHONE=1

# Server-only
SUPABASE_SERVICE_ROLE_KEY=

# Automatizacion (solo servidor): cada agente conserva su configuracion independiente.
# OPENAI_MODEL solo controla interpretacion auxiliar. Extraccion, alcance y medios usan GPT-6 Luna.
# Volver solo el extractor al modelo anterior: OPENAI_MODEL_EXTRACTOR=gpt-4.1-mini
# El redactor, sus borradores y reescrituras usan GPT-6 Luna por defecto.
# Volver solo el redactor al modelo anterior: OPENAI_MODEL_WRITER=gpt-4.1-mini
# OPENAI_MODEL=gpt-4.1
# OPENAI_MODEL_EXTRACTOR=gpt-6-luna
# Solo para extractor GPT-6 Luna; opciones: none, low (predeterminado), medium, high, xhigh, max.
# OPENAI_EXTRACTOR_REASONING_EFFORT=low
# OPENAI_MODEL_WRITER=gpt-6-luna
# Solo para redactor GPT-6 Luna; independiente del extractor y del revisor.
# Opciones: none, low (predeterminado), medium, high, xhigh, max.
# OPENAI_WRITER_REASONING_EFFORT=low
# OPENAI_MODEL_SCOPE=gpt-6-luna
# OPENAI_SCOPE_REASONING_EFFORT=low
# OPENAI_MODEL_MEDIA=gpt-6-luna
# OPENAI_MEDIA_REASONING_EFFORT=low
# Luna no admite audio directo: la voz se transcribe con un modelo especializado
# y su significado lo interpreta el extractor Luna. No usar Luna en esta variable.
# OPENAI_TRANSCRIPTION_MODEL=whisper-1
# El revisor usa GPT-6 Luna; volver solo ese rol: OPENAI_MODEL_REVIEWER=gpt-5-mini.
# OPENAI_MODEL_REVIEWER=gpt-6-luna
# Luna: none, low (predeterminado), medium, high, xhigh, max.
# GPT-5 mini: minimal, low (predeterminado), medium, high.
# OPENAI_REVIEW_REASONING_EFFORT=low

# Server-only — Meta CAPI (vacío en localhost habitual para no enviar)
META_CAPI_BACKEND_URL=
META_CAPI_INTERNAL_SECRET=
# Lane: fuera de Vercel production el código fuerza `test`.
# En production: META_CAPI_DELIVERY_LANE=test|live (o META_MODE=test).
# META_CAPI_DELIVERY_LANE=test


# Migradas a DigitalOcean (NO configurar en Vercel del front):
# META_CAPI_ACCESS_TOKEN
# META_DATASET_ID
# META_TEST_EVENT_CODE

# Ads Insights / campañas (server-only FE). NO reutilizar tokens CAPI/WA.
# META_AD_ACCOUNT_ID=act_…
# META_ADS_ACCESS_TOKEN=   # System User con ads_read
# META_MARKETING_ACCESS_TOKEN=
# META_SYSTEM_USER_TOKEN=

# Purchase captura CRM (envío Nest sigue OFF salvo META_PURCHASE_DELIVERY_ENABLED=true en Nest+FE)
# META_SALES_CURRENCY=USD   # ISO-4217 explícita para nuevos cierres; no rellena históricos NULL
# META_PURCHASE_DELIVERY_ENABLED=false

# Cron sync Nest lookup → conversion_log (Bearer CRON_SECRET)
# CRON_SECRET=

# WhatsApp LeadSubmitted BM (default off — sin escrituras ni envío)
META_WA_LEAD_SUBMITTED_ENABLED=false
META_WA_LEAD_SUBMITTED_DELIVERY_ENABLED=false
META_WA_CRM_QUALIFICATION_DELIVERY_ENABLED=false
KOMMO_WEBHOOK_ALLOWED_CONTACT_ID=
# Distintos: WABA → user_data; messaging dataset → Graph {id}/events (nunca pixel web)
# META_WABA_ID=
# META_MESSAGING_DATASET_ID=
