# =============================================================================
# Separación de entornos
# =============================================================================
# Habitual (localhost → Supabase Lavilet REAL xhjnyntywqhczdtecgim):
#   npm run env:remote   # restaura .env.local desde .env
#   npm run dev
#
# Financing local opcional (127.0.0.1:54331):
#   npm run env:local-financing
#   npm run dev
#   (volver: npm run env:remote)
#
# Vercel producción: proyecto "lavilet" (www.lavilett.com). No usar proyecto "frontend".
# =============================================================================

# Público (browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_COOKIE_BANNER_ENABLED=true
# Temporal: saltar pedido de celular al abrir Simular/Financiamiento (localhost ya lo salta)
# NEXT_PUBLIC_TOUR_TOOLS_SKIP_PHONE=1

# Server-only
SUPABASE_SERVICE_ROLE_KEY=

# Server-only — Meta CAPI (vacío en localhost habitual para no enviar)
META_CAPI_BACKEND_URL=
META_CAPI_INTERNAL_SECRET=

# Migradas a DigitalOcean (NO configurar en Vercel del front):
# META_CAPI_ACCESS_TOKEN
# META_DATASET_ID
