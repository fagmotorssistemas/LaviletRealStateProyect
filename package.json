{
  "name": "lavilet-real-estate",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/print-env-banner.cjs && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "env:remote": "node scripts/restore-remote-env-local.cjs",
