    "test:integrations": "node --test scripts/integrations.test.cjs",
    "test:ctwa-kommo": "node --require ./scripts/test-typescript.cjs --test scripts/ctwa-kommo.test.cjs scripts/ctwa-kommo-sql.test.cjs",
    "test:unit-model": "node --test scripts/unit-model-viewer.test.cjs",
